@page "/productos"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using PortalProductos.Controlador
@using EntidadesProductos = PortalProductos.Modelo.Entidades
@inject IProductoServices ProductoService
@inject ISecurityService SecurityService
@inject NavigationManager Navigation


<PageTitle>Productos</PageTitle>
<h3>Catálogo de Productos</h3>

<!-- #region Bloque busqueda/insertar -->
@if (!mostrarFormularioAlta)
{
<!-- Busqueda Dinamica -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5><i class="bi bi-search"></i> Consulta de productos</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Buscar por Nombre</label>
                    <!-- @bind-Value:after ejecuta el filtro instantáneamente al escribir/modificar -->
                    <input type="text" 
                           class="form-control" 
                           placeholder="Introduce un nombre..." 
                           @bind-value="filtroNombreProveedor" 
                           @bind-value:event="oninput"
                           @bind-value:after="FiltrarProductos"/>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Filtrar por ID de Proveedor</label>
                    <input type="text" 
                           class="form-control" 
                           placeholder="Introduce un id..." 
                           @bind-value="filtroIdProveedor" 
                           @bind-value:event="oninput"
                           @bind-value:after="FiltrarProductos"/>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">
                        Limpiar Filtros
                    </button>
                </div>

                <div class="col-md-5">
                    <label for="selectProveedor" class="form-label font-weight-bold">Proveedor</label>
                    <select id="selectProveedor" class="form-select" @bind="IdProveedorSeleccionado" @bind:after="FiltrarProductos">
                        <option value="0" selected>-- Seleccione un proveedor --</option>
                        @if (proveedores != null)
                        {
                            @foreach (var proveedor in proveedores)
                            {
                                <option value="@proveedor.IdProveedor" title="@proveedor.DescripcionProveedor">
                                    @proveedor.NombreProveedor (@proveedor.EmpresaProveedor)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-5">
                    <label for="selectTipoProducto" class="form-label font-weight-bold">Tipo de Producto</label>
                    <select id="selectTipoProducto" class="form-select" @bind="IdTipoProductoSeleccionado" @bind:after="FiltrarProductos">
                        <option value="0" selected>-- Seleccione un tipo --</option>
                        @if (tiposProductos != null)
                        {
                            @foreach (var tipo in tiposProductos)
                            {
                                <option value="@tipo.IdTipoProducto" title="@tipo.DescripcionTipo">
                                    @tipo.NombreTipoProducto
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
}
else
{
<!-- Insertar o actualizar -->
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@(editarProducto ? "Modificar producto" : "Crear nuevo producto")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="productoForm" OnValidSubmit="GuardarNuevoProducto">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Nombre del Producto</label>
                        <InputText @bind-Value="productoForm.NombreProducto" class="form-control" placeholder="Ej. Teclado Mecánico" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Precio de reventa ($)</label>
                        <InputNumber @bind-Value="productoForm.CostoReventa" class="form-control" placeholder="0.00" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Precio de proveedor ($)</label>
                        <InputNumber @bind-Value="productoForm.PrecioProducto" class="form-control" placeholder="0.00" />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">ID del Proveedor</label>
                        <InputText @bind-Value="productoForm.IdProductoProveedor" class="form-control" />
                    </div>

                    <div class="col-md-5">
                        <label for="selectProveedor" class="form-label font-weight-bold">Proveedor</label>
                        <select id="selectProveedor" class="form-select" @bind="IdProveedorSeleccionado">
                            <option value="0" selected>-- Seleccione un proveedor --</option>
                            @if (proveedores != null)
                            {
                                @foreach (var proveedor in proveedores)
                                {
                                    <option value="@proveedor.IdProveedor" title="@proveedor.DescripcionProveedor">
                                        @proveedor.NombreProveedor (@proveedor.EmpresaProveedor)
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label for="selectTipoProducto" class="form-label font-weight-bold">Tipo de Producto</label>
                        <select id="selectTipoProducto" class="form-select" @bind="IdTipoProductoSeleccionado">
                            <option value="0" selected>-- Seleccione un tipo --</option>
                            @if (tiposProductos != null)
                            {
                                @foreach (var tipo in tiposProductos)
                                {
                                    <option value="@tipo.IdTipoProducto" title="@tipo.DescripcionTipo">
                                        @tipo.NombreTipoProducto
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-lg"></i> @(editarProducto ? "Actualizar" : "Guardar")
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}
<!-- #endregion -->

<!-- #region Boton swap estado -->
<div class="d-flex justify-content-end mb-3">
    <button class="btn @(mostrarFormularioAlta ? "btn-secondary" : "btn-primary")" 
            @onclick="AlternarVista">
        <i class="bi @(mostrarFormularioAlta ? "bi-arrow-left" : "bi-plus-lg")"></i> 
        @(mostrarFormularioAlta ? "Volver a la Búsqueda" : "Agregar Nuevo Producto")
    </button>
</div>
<!-- #endregion -->

<!-- #region Tabla -->
@if (productos == null)
{
    <p><em>Cargando productos...</em></p>
}
else if (!productos.Any())
{
    <div class="alert alert-info">No existen productos que coincidan con los criterios especificados.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID del producto</th>
                <th>Nombre del producto</th>
                <th>Precio de reventa</th>
                <th>Nombre del proveedor</th>
                <th>Empresa del proveedor</th>
                <th>Tipo de producto</th>
                <th>Precio de proveedor</th>
                <th>Id del proveedor</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in productos)
            {
                <tr>
                    <td>@prod.IdProducto</td>
                    <td>@prod.NombreProducto</td>
                    <td>$@prod.CostoReventa</td>
                    <td>@prod.NombreProveedor</td>
                    <td>@prod.EmpresaProveedor</td>
                    <td>@prod.NombreTipoProducto</td>
                    <td>$@prod.PrecioProducto</td>
                    <td>@prod.IdProductoProveedor</td>
                    <td>
                        <button class="btn btn-sm btn-outline-warning me-1"
                        @onclick="() => CargarEditar(prod)">Editar</button>

                        <button class="btn btn-sm btn-outline-danger"
                        @onclick="() => EliminarProducto(prod.IdProducto)">
                            <i class="bi bi-trash"></i>Eliminar
                        </button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<!-- #endregion -->

<!-- #region Modal error-->
@if (mostrarError)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-danger shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Error detectado
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="OcultarError"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 text-dark">@mensajeErrorModal</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="OcultarError">OK</button>
                </div>
            </div>
        </div>
    </div>
}
<!-- #endregion-->

@code {
    #region Variables
    private List<EntidadesProductos.Productos>? productos;
    private List<EntidadesProductos.Proveedores>? proveedores;
    private List<EntidadesProductos.TiposProductos>? tiposProductos;
    private int IdProveedorSeleccionado { get; set; } = 0;
    private int IdTipoProductoSeleccionado { get; set; } = 0;
    private EntidadesProductos.Productos productoForm = new EntidadesProductos.Productos();
    private string? filtroNombreProveedor;
    private string? filtroIdProveedor;
    private bool mostrarFormularioAlta = false;
    private bool editarProducto = false;
    private bool mostrarError = false;
    private string mensajeErrorModal = string.Empty;
    //protected override async Task OnInitializedAsync() => await CargarProductos();
    //protected override async Task OnInitializedAsync() => await FiltrarProductos();
    #endregion

    #region Consultas
    protected override async Task OnInitializedAsync()
    {
        if (!SecurityService.isAuth)
        {
            Navigation.NavigateTo("");
            return;
        }
        await CargarProveedores();
        await CargarTipos();
        await CargarProductos();
    }

    private void AlternarVista()
    {
        mostrarFormularioAlta = !mostrarFormularioAlta;

        if (!mostrarFormularioAlta)
        {
            productoForm = new EntidadesProductos.Productos();
            IdProveedorSeleccionado = 0;
            IdTipoProductoSeleccionado = 0;
            editarProducto = false;
        }
    }

    private async Task CargarProductos()
    {
        productos = await ProductoService.ObtieneProductosAsync();
    }

    private async Task CargarProveedores()
    {
        proveedores = await ProductoService.ObtieneProveedoresAsync();
    }

    private async Task CargarTipos()
    {
        tiposProductos = await ProductoService.ObtieneTiposAsync();
    }

    private async Task FiltrarProductos()
    {
        productos = await ProductoService.ConsultaDinamica(filtroNombreProveedor, filtroIdProveedor, IdProveedorSeleccionado, IdTipoProductoSeleccionado);
    }
    #endregion

    #region CUD
    private async Task GuardarNuevoProducto()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(productoForm.NombreProducto) && !string.IsNullOrWhiteSpace(productoForm.IdProductoProveedor) && productoForm.PrecioProducto > 0 && productoForm.CostoReventa > 0 && IdProveedorSeleccionado > 0 && IdTipoProductoSeleccionado > 0)
            {

                if (editarProducto)
                {
                    await ProductoService.EditarProductoAsync(productoForm);
                }
                else
                {
                    VincularValores();
                    await ProductoService.AgregarProducto(productoForm);
                }

                productoForm = new EntidadesProductos.Productos();

                mostrarFormularioAlta = false;

                await CargarProductos();
            }
            else
            {
                throw new ArgumentException("Uno o más elementos de la lista estan vacios.");
            }
        }
        catch(ArgumentException ae)
        {
            MostrarError(ae.Message);
        }
        catch(Exception ex)
        {
            MostrarError(ex.Message);
        }

    }

    private async Task EliminarProducto(int id)
    {
        try
        {
            await ProductoService.EliminarProductoAsync(id);

            await CargarProductos();
        }
        catch(Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private void CargarEditar(EntidadesProductos.Productos productoSelect)
    {
        productoForm = new EntidadesProductos.Productos
        {
            IdProducto = productoSelect.IdProducto,
            NombreProducto = productoSelect.NombreProducto,
            CostoReventa = productoSelect.CostoReventa,
            IdProveedor = productoSelect.IdProveedor,
            NombreProveedor = productoSelect.NombreProveedor,
            EmpresaProveedor = productoSelect.EmpresaProveedor,
            IdTipoProducto = productoSelect.IdTipoProducto,
            NombreTipoProducto = productoSelect.NombreTipoProducto,
            PrecioProducto = productoSelect.PrecioProducto,
            IdProductoProveedor = productoSelect.IdProductoProveedor
        };

        IdProveedorSeleccionado = productoForm.IdProveedor;
        IdTipoProductoSeleccionado = productoForm.IdTipoProducto;

        editarProducto = true;
        mostrarFormularioAlta = true;
    }

    private void VincularValores()
    {
        productoForm.IdProveedor = IdProveedorSeleccionado;
        productoForm.IdTipoProducto = IdTipoProductoSeleccionado;
        productoForm.NombreProveedor = string.Empty;
        productoForm.NombreTipoProducto = string.Empty;
        productoForm.EmpresaProveedor = string.Empty;
    }

    private async Task LimpiarFiltros()
    {
        filtroNombreProveedor = string.Empty;
        filtroIdProveedor = string.Empty;
        IdProveedorSeleccionado = 0;
        IdTipoProductoSeleccionado = 0;
        await CargarProductos();
    }

    private void MostrarError(string mensaje)
    {
        mostrarError = true;
        mensajeErrorModal = mensaje;
        StateHasChanged();
    }

    private void OcultarError()
    {
        mostrarError = false;
        mensajeErrorModal = string.Empty;
    }

    #endregion
}
