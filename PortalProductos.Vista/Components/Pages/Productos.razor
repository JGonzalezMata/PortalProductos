@page "/productos"
@rendermode InteractiveServer
@using PortalProductos.Controlador
@using EntidadesProductos = PortalProductos.Modelo.Entidades
@inject IProductoServices ProductoService


<PageTitle>Productos</PageTitle>
<h3>Catálogo de Productos</h3>

@if (!mostrarFormularioAlta)
{
<!-- Busqueda Dinamica -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5><i class="bi bi-search"></i> Consulta de productos</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Buscar por Nombre</label>
                    <!-- @bind-Value:after ejecuta el filtro instantáneamente al escribir/modificar -->
                    <input type="text" 
                           class="form-control" 
                           placeholder="Introduce un nombre..." 
                           @bind-value="filtroNombre" 
                           @bind-value:event="oninput"
                           @bind-value:after="FiltrarProductos"/>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Filtrar por ID Cliente</label>
                    <input type="text" 
                           class="form-control" 
                           placeholder="Introduce un id..." 
                           @bind-value="filtroIdCliente" 
                           @bind-value:event="oninput"
                           @bind-value:after="FiltrarProductos"/>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">
                        Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
<!-- Insertar -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5>Crear Nuevo Producto</h5>
        </div>
        <div class="card-body">
            <EditForm Model="nuevoProducto" OnValidSubmit="GuardarNuevoProducto">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Nombre del Producto</label>
                        <InputText @bind-Value="nuevoProducto.Nombre" class="form-control" placeholder="Ej. Teclado Mecánico" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Precio ($)</label>
                        <InputNumber @bind-Value="nuevoProducto.Precio" class="form-control" placeholder="0.00" />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">ID de Cliente</label>
                        <InputText @bind-Value="nuevoProducto.idCliente" class="form-control" />
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-lg"></i> Guardar
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Boton swap estado -->
<div class="d-flex justify-content-end mb-3">
    <button class="btn @(mostrarFormularioAlta ? "btn-secondary" : "btn-primary")" 
            @onclick="AlternarVista">
        <i class="bi @(mostrarFormularioAlta ? "bi-arrow-left" : "bi-plus-lg")"></i> 
        @(mostrarFormularioAlta ? "Volver a la Búsqueda" : "Agregar Nuevo Producto")
    </button>
</div>

<!-- Tabla -->
@if (productos == null)
{
    <p><em>Cargando productos...</em></p>
}
else if (!productos.Any())
{
    <div class="alert alert-info">No existen productos que coincidan con los criterios especificados.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Id Cliente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in productos)
            {
                <tr>
                    <td>@prod.Id</td>
                    <td>@prod.Nombre</td>
                    <td>$@prod.Precio</td>
                    <td>@prod.idCliente</td>
                    <td>
                        <button class="btn btn-sm btn-outline-warning me-1">Editar</button>
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<EntidadesProductos.Productos>? productos;
    private EntidadesProductos.Productos nuevoProducto = new EntidadesProductos.Productos();
    private string? filtroNombre;
    private string? filtroIdCliente;
    private bool mostrarFormularioAlta = false;

    //protected override async Task OnInitializedAsync() => await CargarProductos();
    protected override async Task OnInitializedAsync() => await FiltrarProductos();

    private void AlternarVista()
    {
        mostrarFormularioAlta = !mostrarFormularioAlta;

        if (!mostrarFormularioAlta)
        {
            nuevoProducto = new EntidadesProductos.Productos();
        }
    }

    private async Task CargarProductos()
    {
        productos = await ProductoService.ObtieneProductosAsync();
    }

    private async Task GuardarNuevoProducto()
    {
        if (!string.IsNullOrWhiteSpace(nuevoProducto.Nombre))
        {
            await ProductoService.AgregarProducto(nuevoProducto);

            nuevoProducto = new EntidadesProductos.Productos();

            mostrarFormularioAlta = false;

            await CargarProductos();
        }
    }

    private async Task FiltrarProductos()
    {
        productos = await ProductoService.ConsultaDinamica(filtroNombre, filtroIdCliente);
    }

    private async Task LimpiarFiltros()
    {
        filtroNombre = string.Empty;
        filtroIdCliente = string.Empty;
        await FiltrarProductos();
    }
}
